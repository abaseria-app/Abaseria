# Shared price database settings. Values come from Supabase → Project Settings → API.
#
# Dev values go in .env.development (committed: publishable keys are meant to be public; the rules in
# supabase/schema.sql do the protecting). To point one computer somewhere else, use .env.development.local.
# Production values are GitHub repository variables, read by .github/workflows/deploy.yml.
#
# Only the publishable key ever goes in the app. Never the secret / service_role key or the database password.
VITE_SUPABASE_URL=https://YOUR-DEV-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# "dev" for npm run dev, "prod" for production builds. The app won't connect if this doesn't match.
VITE_SUPABASE_ENV=dev
